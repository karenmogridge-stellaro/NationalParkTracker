{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/get", "destination": "https://apps.apple.com/app/id6760982981", "permanent": false },
    { "source": "/ig", "destination": "https://www.instagram.com/parkatlas.io/", "permanent": false },
    { "source": "/invite/:code", "destination": "https://apps.apple.com/app/id6760982981", "permanent": false }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(.*)\\.(png|svg|pdf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
